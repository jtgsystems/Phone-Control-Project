{
  "name": "phone-control-project",
  "version": "2.0.0",
  "description": "Advanced Android device control with modern web interface and wireless support",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "webpack --mode production",
    "test": "jest",
    "install-deps": "npm install && python -m pip install -r requirements.txt",
    "electron": "electron electron-main.js",
    "electron-dev": "NODE_ENV=development electron electron-main.js",
    "docker-build": "docker-compose build",
    "docker-up": "docker-compose up -d",
    "docker-down": "docker-compose down"
  },
  "keywords": [
    "android",
    "adb",
    "scrcpy",
    "device-control",
    "remote-control"
  ],
  "author": "JTG Systems",
  "license": "MIT",
  "dependencies": {
    "electron": "^44.5.1",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "node-adb": "^0.1.6",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "webpack": "^5.111.1"
  }
}
